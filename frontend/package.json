    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.3",
    "@azure/msal-react": "^5.5.4",
    "exceljs": "^4.4.0",
